{
  "id": "orca-command",
  "name": "Fulcra Commands",
  "description": "Owner-only native Discord commands for one explicitly delegated saved session.",
  "version": "0.1.0",
  "activation": { "onStartup": true },
  "configSchema": {
    "type": "object",
    "properties": {
      "bindingsDir": { "type": "string", "minLength": 1 },
      "accountId": { "type": "string", "minLength": 1, "maxLength": 128 },
      "conversationId": { "type": "string", "minLength": 1, "maxLength": 128 },
      "senderId": { "type": "string", "minLength": 1, "maxLength": 128 },
      "sessionId": { "type": "string", "format": "uuid" }
    },
    "required": ["bindingsDir", "accountId", "conversationId", "senderId", "sessionId"],
    "additionalProperties": false
  }
}
