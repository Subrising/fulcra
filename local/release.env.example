# Trusted shell configuration. Copy to release.env (ignored); quote paths with spaces.
# Absolute paths are examples/placeholders only. Never put credentials in this template.
NODE_BIN='node'
PYTHON_BIN='python3'
# Reviewed single-checkout commit; all provenance commit fields use it.
EXPECTED_REPO_COMMIT='<40-character-reviewed-repo-sha>'
# Optional space-separated commits required to remain ancestors (including imported heads).
REQUIRED_ANCESTORS=''
STAGING_DIR='/path/to/private/candidate-staging'
EVIDENCE_DIR='/path/to/private/candidate-evidence'
SCRATCH_DIR='/path/to/private/release-scratch'
SPACE_VOLUME='/path/to/build-volume'
INTERNAL_MIN_GIB=9
EXTERNAL_MIN_GIB=25
# Existing scheduler adapter: runner <heavy-lock-path> <command> [args...].
# Supply a local adapter if the host scheduler uses a different argument convention.
HEAVY_LOCK_RUNNER='/path/to/heavy-lock-runner'
HEAVY_LOCK_PATH='/path/to/heavy-lock'
CANDIDATE_APP='/path/to/private/candidate-staging/output/mac-arm64/Fulcra.app'
PREVIOUS_APP='/path/to/read-only/previous/Fulcra.app'
# Paths to reviewed scanner inputs. Baseline has adapter digests; handoff has bundle.entries.
REVIEWS='/path/to/private/packaged-reviews.json'
ADAPTER_BASELINE='/path/to/private/adapter-baseline.json'
PREVIOUS_HANDOFF='/path/to/private/previous-handoff.json'
# Zip verifies this seal; it never overwrites an existing archive.
EXPECTED_BUNDLE_SHA='<64-character-reviewed-bundle-sha256>'
ZIP_OUTPUT_DIR='/path/to/private/zip-output'
ZIP_NAME='Fulcra-version-mac-arm64.zip'
# Existing compiled host test adapter (no build is performed by the suite wrapper).
TEST_HOST='/path/to/private/test-host.mjs'
FILE_TIMEOUT=600
# Gate driver is owned/reviewed separately. Point at release/gates-8.sh only for candidate 8.
GATE_DRIVER='/path/to/owner-reviewed/gates-9.sh'
# Legacy candidate-8 fixture scripts and operator scripts, retained locally until owner ports them.
GATE_FIXTURES_DIR='/path/to/reviewed/gate-fixtures'
GATE_OPERATOR_DIR='/path/to/reviewed/operator-fixtures'
GATE_CHANGE_PAYLOAD='/path/to/private/change-payload.json'
PROBE_CLIENT='/path/to/private/candidate-probe-client.mjs'
TESTDEVICE_CLIENT='/path/to/private/candidate-testdevice-client.mjs'
MACBOOK_APP='/path/to/private/testdevice/Fulcra.app'
# Reserved for owner-reviewed signing/notarization/staging adapters; unsigned packaging ignores these.
SIGNING_IDENTITY='<signing-identity>'
NOTARY_PROFILE='<local-keychain-profile-name>'
RELEASE_HOST='<release-host-label>'
PLUGIN_PIN='<reviewed-plugin-client-sha256>'
