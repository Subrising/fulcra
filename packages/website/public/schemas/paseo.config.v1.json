{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "number",
      "const": 1
    },
    "daemon": {
      "type": "object",
      "properties": {
        "listen": {
          "type": "string"
        },
        "hostnames": {
          "anyOf": [
            {
              "type": "boolean",
              "const": true
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "allowedHosts": {
          "anyOf": [
            {
              "type": "boolean",
              "const": true
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "trustedProxies": {
          "description": "Express trusted proxy setting for X-Forwarded-* headers. Defaults to [\"loopback\"]. Use true only when the final trusted proxy overwrites client-supplied forwarded headers.",
          "anyOf": [
            {
              "type": "boolean",
              "const": true
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "mcp": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "injectIntoAgents": {
              "type": "boolean"
            },
            "injectLabels": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "type": "string"
              }
            }
          },
          "additionalProperties": {}
        },
        "usage": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          }
        },
        "browserTools": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          },
          "additionalProperties": {}
        },
        "git": {
          "type": "object",
          "properties": {
            "maxProcessesPerSecond": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "maxProcessConcurrency": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "backgroundFetch": {
              "type": "boolean"
            },
            "backgroundFetchIntervalMs": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          },
          "additionalProperties": false
        },
        "memoryGuard": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "swapUsedPercent": {
              "type": "number",
              "minimum": 1,
              "maximum": 100
            },
            "freeMemoryPercent": {
              "type": "number",
              "minimum": 1,
              "maximum": 100
            },
            "swapDiskFreeGB": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000
            },
            "warnAllowAvailableGB": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000
            }
          },
          "additionalProperties": false
        },
        "autoArchiveAfterMerge": {
          "type": "boolean"
        },
        "explainDailyLimit": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "notificationMode": {
          "type": "string",
          "enum": ["all", "primes", "off"]
        },
        "enableTerminalAgentHooks": {
          "type": "boolean"
        },
        "reportUpOnTurnEnd": {
          "type": "boolean"
        },
        "nativeFinishNotices": {
          "type": "boolean"
        },
        "receiptRetentionMs": {
          "type": "integer",
          "exclusiveMinimum": 21600000,
          "maximum": 9007199254740991
        },
        "eventDispatcherEnabled": {
          "type": "boolean"
        },
        "ledgerDispatchEnabled": {
          "type": "boolean"
        },
        "projectDispatch": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "enabled": {
                "default": false,
                "type": "boolean"
              },
              "enableId": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              "hostId": {
                "type": "string",
                "pattern": "^srv_[A-Za-z0-9_-]+$"
              },
              "daemonHome": {
                "type": "string",
                "pattern": "^\\/"
              },
              "ledgerRoot": {
                "type": "string",
                "pattern": "^\\/"
              },
              "leadId": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              "maxParallel": {
                "type": "integer",
                "minimum": 1,
                "maximum": 8
              },
              "maxTotalStarts": {
                "default": 10,
                "type": "integer",
                "minimum": 1,
                "maximum": 100
              },
              "dailyStartBudget": {
                "default": 5,
                "type": "integer",
                "minimum": 1,
                "maximum": 100
              },
              "minStartIntervalSeconds": {
                "default": 60,
                "type": "integer",
                "minimum": 1,
                "maximum": 86400
              },
              "holdLabels": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "approvals": {
                "default": {},
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9]*-\\d+$"
                },
                "additionalProperties": {
                  "type": "object",
                  "properties": {
                    "generation": {
                      "type": "string",
                      "format": "uuid",
                      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                    },
                    "digest": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    "addedBy": {
                      "anyOf": [
                        {
                          "type": "string",
                          "const": "owner"
                        },
                        {
                          "type": "string",
                          "format": "uuid",
                          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                        }
                      ]
                    },
                    "cwd": {
                      "type": "string",
                      "pattern": "^\\/"
                    }
                  },
                  "required": ["generation", "digest", "addedBy", "cwd"],
                  "additionalProperties": false
                }
              },
              "roles": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "role": {
                      "type": "string",
                      "minLength": 1
                    },
                    "owner": {
                      "type": "string",
                      "minLength": 1
                    },
                    "provider": {
                      "type": "string",
                      "enum": ["claude", "codex"]
                    },
                    "model": {
                      "type": "string",
                      "minLength": 1
                    },
                    "thinking": {
                      "type": "string",
                      "minLength": 1
                    },
                    "mode": {
                      "type": "string",
                      "enum": ["auto", "default", "plan"]
                    },
                    "account": {
                      "default": "personal-workspace-api",
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 80
                    }
                  },
                  "required": ["role", "owner", "provider", "model", "mode"],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "enableId",
              "hostId",
              "daemonHome",
              "ledgerRoot",
              "leadId",
              "maxParallel",
              "roles"
            ],
            "additionalProperties": false
          }
        },
        "idleLeadNudge": {
          "type": "boolean"
        },
        "idleLeadNudgeSkipOwners": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "idleLeadNudgeMinIntervalMinutes": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "reviveOnRestart": {
          "type": "boolean"
        },
        "idleSleepMinutes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10080
        },
        "idleSleepProviders": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "autoArchiveClosedAfterHours": {
          "type": "number",
          "minimum": 0,
          "maximum": 8760
        },
        "autoResumeOnLimit": {
          "type": "boolean"
        },
        "appendSystemPrompt": {
          "type": "string"
        },
        "terminalProfiles": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "command": {
                "type": "string"
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "icon": {
                "type": "string"
              }
            },
            "required": ["id", "name", "command"],
            "additionalProperties": {}
          }
        },
        "agentProfiles": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "icon": {
                "type": "string"
              },
              "color": {
                "type": "string"
              },
              "provider": {
                "type": "string"
              },
              "model": {
                "type": "string"
              },
              "modeId": {
                "type": "string"
              },
              "thinkingOptionId": {
                "type": "string"
              },
              "featureValues": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              },
              "notes": {
                "type": "string"
              }
            },
            "required": ["id", "name", "provider"],
            "additionalProperties": {}
          }
        },
        "cors": {
          "type": "object",
          "properties": {
            "allowedOrigins": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        },
        "relay": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "pairingOfferTtlSeconds": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "requireProtectedSecurity": {
              "description": "Admit only relay clients that negotiate protected endpoint security (replay protection). Defaults to false; older clients still connect while it is off.",
              "type": "boolean"
            },
            "endpoint": {
              "type": "string"
            },
            "publicEndpoint": {
              "type": "string"
            },
            "useTls": {
              "type": "boolean"
            },
            "publicUseTls": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "directRoutes": {
          "type": "object",
          "properties": {
            "advertise": {
              "description": "Direct routes to tell paired devices, when set. Replaces the auto list. For a daemon behind a proxy such as tailscale serve. Host: Tailscale or private IPv4, or a *.ts.net name. Max 8.",
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "host": {
                    "type": "string"
                  },
                  "port": {
                    "type": "number"
                  }
                },
                "required": ["host", "port"],
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        "serviceProxy": {
          "type": "object",
          "properties": {
            "enabled": {
              "description": "Compatibility shim. false suppresses optional service proxy listen/public layers only; localhost proxying remains enabled.",
              "type": "boolean"
            },
            "listen": {
              "description": "Optional service-only listener address. Presence enables the standalone service proxy listener.",
              "type": "string"
            },
            "publicBaseUrl": {
              "description": "Optional public base URL for service host aliases.",
              "type": "string",
              "format": "uri"
            }
          },
          "additionalProperties": false
        },
        "auth": {
          "type": "object",
          "properties": {
            "password": {
              "type": "string",
              "pattern": "^\\$2[aby]\\$\\d{2}\\$[./A-Za-z0-9]{53}$"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "app": {
      "type": "object",
      "properties": {
        "baseUrl": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "providers": {
      "type": "object",
      "properties": {
        "local": {
          "type": "object",
          "properties": {
            "modelsDir": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "pluginRegistries": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "authorization": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["authorization"]
      }
    },
    "pluginsEnabled": {
      "type": "boolean"
    },
    "plugins": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "source": {
                "type": "string",
                "const": "directory"
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "enabled": {
                "type": "boolean"
              }
            },
            "required": ["source", "path"],
            "additionalProperties": false
          }
        ]
      }
    },
    "integrations": {
      "type": "object",
      "properties": {
        "oauthClientIds": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{1,31}$"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        }
      },
      "additionalProperties": false
    },
    "worktrees": {
      "type": "object",
      "properties": {
        "root": {
          "type": "string",
          "minLength": 1
        },
        "servicePorts": {
          "type": "object",
          "properties": {
            "range": {
              "type": "string",
              "pattern": "^(\\d{1,5})-(\\d{1,5})$"
            },
            "portScript": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "agents": {
      "type": "object",
      "properties": {
        "providers": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "extends": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "command": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "env": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "string"
                }
              },
              "options": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              },
              "params": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              },
              "models": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "label": {
                      "type": "string",
                      "minLength": 1
                    },
                    "description": {
                      "type": "string"
                    },
                    "isDefault": {
                      "type": "boolean"
                    },
                    "thinkingOptions": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "label": {
                            "type": "string"
                          },
                          "description": {
                            "type": "string"
                          },
                          "isDefault": {
                            "type": "boolean"
                          }
                        },
                        "required": ["id", "label"]
                      }
                    }
                  },
                  "required": ["id", "label"]
                }
              },
              "additionalModels": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "label": {
                      "type": "string",
                      "minLength": 1
                    },
                    "description": {
                      "type": "string"
                    },
                    "isDefault": {
                      "type": "boolean"
                    },
                    "thinkingOptions": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "label": {
                            "type": "string"
                          },
                          "description": {
                            "type": "string"
                          },
                          "isDefault": {
                            "type": "boolean"
                          }
                        },
                        "required": ["id", "label"]
                      }
                    }
                  },
                  "required": ["id", "label"]
                }
              },
              "disallowedTools": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "paseoTools": {
                "type": "object",
                "properties": {
                  "enabled": {
                    "type": "boolean"
                  },
                  "disabledTools": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "allowedTools": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "create_agent",
                        "send_agent_prompt",
                        "list_agents",
                        "get_agent_status",
                        "get_agent_activity",
                        "archive_agent",
                        "update_agent",
                        "cancel_agent",
                        "list_pending_permissions",
                        "respond_to_permission",
                        "supervisor_inbox",
                        "supervisor_acknowledge",
                        "browser_list_tabs",
                        "browser_new_tab",
                        "browser_snapshot",
                        "browser_click",
                        "browser_fill",
                        "browser_wait",
                        "browser_type",
                        "browser_keypress",
                        "browser_navigate",
                        "browser_back",
                        "browser_forward",
                        "browser_reload",
                        "browser_screenshot",
                        "browser_upload",
                        "browser_hover",
                        "browser_select",
                        "browser_drag",
                        "browser_logs",
                        "browser_evaluate",
                        "browser_scroll",
                        "browser_resize",
                        "browser_close_tab",
                        "list_terminals",
                        "create_terminal",
                        "capture_terminal",
                        "send_terminal_keys",
                        "kill_terminal",
                        "create_schedule",
                        "list_schedules",
                        "inspect_schedule",
                        "update_schedule",
                        "pause_schedule",
                        "resume_schedule",
                        "delete_schedule",
                        "run_schedule_once",
                        "schedule_logs",
                        "create_heartbeat",
                        "delete_heartbeat",
                        "create_workspace",
                        "list_workspaces",
                        "rename_workspace",
                        "archive_workspace",
                        "list_workspace_scripts",
                        "start_workspace_script",
                        "stop_workspace_script",
                        "list_providers",
                        "list_models",
                        "list_profiles",
                        "inspect_provider",
                        "produce_artifact",
                        "kill_agent",
                        "set_agent_mode",
                        "speak"
                      ]
                    }
                  }
                }
              },
              "enabled": {
                "type": "boolean"
              },
              "order": {
                "type": "number"
              }
            }
          }
        },
        "idleRuntimeCleanup": {
          "type": "boolean"
        },
        "resumeOnStartup": {
          "type": "boolean"
        },
        "resumePrompt": {
          "type": "string"
        },
        "catalogRefreshTimeoutMs": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 2147483647
        },
        "metadataGeneration": {
          "type": "object",
          "properties": {
            "providers": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "provider": {
                    "type": "string",
                    "minLength": 1
                  },
                  "model": {
                    "type": "string",
                    "minLength": 1
                  },
                  "thinkingOptionId": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": ["provider"],
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        "skills": {
          "type": "object",
          "properties": {
            "selection": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "mode": {
                      "type": "string",
                      "const": "all"
                    }
                  },
                  "required": ["mode"],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "mode": {
                      "type": "string",
                      "const": "custom"
                    },
                    "skills": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  },
                  "required": ["mode", "skills"],
                  "additionalProperties": false
                }
              ]
            }
          },
          "additionalProperties": false
        },
        "history": {
          "type": "object",
          "properties": {
            "retention": {
              "type": "string",
              "enum": ["keep", "purge"]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "features": {
      "type": "object",
      "properties": {
        "dictation": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "stt": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "provider": {
                      "type": "string",
                      "const": "local"
                    },
